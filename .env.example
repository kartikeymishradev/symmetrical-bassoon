# REVA Health — Environment Variables Reference
# Copy this file to .env.local (never commit .env.local — it is git-ignored)

# ── Telegram Bots ────────────────────────────────────────────────────────────
# Main Website Consultation Enquiry Bot
TELEGRAM_BOT_TOKEN=your_enquiry_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_enquiry_chat_id_here

# Customer Care & Support Widget Bot
TELEGRAM_SUPPORT_BOT_TOKEN=your_support_bot_token_here
TELEGRAM_SUPPORT_CHAT_ID=your_support_chat_id_here

# ── Google APIs ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GOOGLE_SHEET_ID=your_google_spreadsheet_id_here
GOOGLE_CALENDAR_ID=your_google_calendar_id_here

# Optional: set to "false" to disable Google Meet link generation
GOOGLE_MEET_ENABLED=true

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── Working Hours & Slot Configuration ───────────────────────────────────────
# Slot times use 24-hour HH:MM format. Invalid values → fallback to defaults.
# Defaults: 08:00–22:30, 30-min slots, 60-min lead time, 15-min hold expiry.

WORK_START_TIME=08:00          # First slot start time (24hr HH:MM)
WORK_END_TIME=22:30            # Last slot must END by this time (e.g. last start = 22:00 for 30-min slots)
SLOT_DURATION_MIN=30           # Duration of each slot in minutes
MIN_BOOKING_LEAD_MINUTES=60    # How many minutes ahead a same-day slot must be (prevents instant booking)
HOLD_EXPIRY_MINUTES=15         # How long a SLOT_HOLD is valid before it expires and frees the slot

# ── WhatsApp (Optional) ───────────────────────────────────────────────────────
# WHATSAPP_API_TOKEN=your_whatsapp_token_here
# WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
